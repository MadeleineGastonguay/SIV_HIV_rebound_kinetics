<DATAFILE>

[FILEINFO]
file={path='../../../../../data/derived/STUDY1_CONTROL_DATA.txt'}
delimiter = tab
header={id, time, vl, censor}

[CONTENT]
id = {use=identifier}
time = {use=time}
vl = {use=observation, type=continuous}
censor = {use=censored}

<MODEL>

[INDIVIDUAL]
input = {NPs_pop, omega_NPs, betas_pop, omega_betas, lambda_pop, omega_lambda, m_pop, omega_m, p_pop, omega_p, ta_pop, omega_ta}

DEFINITION:
NPs = {distribution=logNormal, typical=NPs_pop, sd=omega_NPs}
betas = {distribution=logNormal, typical=betas_pop, sd=omega_betas}
lambda = {distribution=logNormal, typical=lambda_pop, sd=omega_lambda}
m = {distribution=logNormal, typical=m_pop, sd=omega_m}
p = {distribution=logNormal, typical=p_pop, sd=omega_p}
ta = {distribution=logNormal, typical=ta_pop, sd=omega_ta}

[LONGITUDINAL]
input = {a}

file = '../../../../../model/2regime_model_delay.txt'

DEFINITION:
vl = {distribution=normal, prediction=tot, errorModel=constant(a)}

<FIT>
data = 'vl'
model = vl

<PARAMETER>
NPs_pop = {value=0.0756280698080145, method=MLE}
a = {value=3.26836100686342, method=MLE}
betas_pop = {value=0.0033578182387052, method=MLE}
lambda_pop = {value=159.126370927393, method=MLE}
m_pop = {value=9.21041168340653, method=MLE}
omega_NPs = {value=2.09421865083277, method=MLE}
omega_betas = {value=4.96118090767413, method=MLE}
omega_lambda = {value=4.74672018736601, method=MLE}
omega_m = {value=3.06633256189525, method=MLE}
omega_p = {value=1.54533426184207, method=MLE}
omega_ta = {value=4.63604534510523, method=MLE}
p_pop = {value=0.834587539047303, method=MLE}
ta_pop = {value=0.0105648850784497, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMean, conditionalMode })
fim(method = StochasticApproximation)
logLikelihood(method = ImportanceSampling)

[PLOTS]
run = true
plots = {indfits = {selected = true}, parameterdistribution = {selected = true}, obspred = {selected = true}, covariancemodeldiagnosis = {selected = true}, covariatemodeldiagnosis = {selected = true}, vpc = {selected = true}, residualsscatter = {selected = true}, residualsdistribution = {selected = true}, randomeffects = {selected = true}, saemresults = {selected = true}}

[SETTINGS]
GLOBAL:
exportpath = '../../'

POPULATION:
burniniterations = 50
smoothingiterations = 500
exploratoryiterations = 1000
simulatedannealingiterations = 1000

